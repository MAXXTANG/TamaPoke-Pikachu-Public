+void Pet::selectSpecies(int16_t dex) {
+  if (dex < 1 || dex > DEX_COUNT) return;
+  prevSpeciesId = speciesId;
+  speciesId = eggTarget = dex;
+  starterPick = false;
+  eggTaps = 3;
+  shiny = eggShiny = false;
+  ceremony = CER_NONE;
+  registerSpecies(dex);
+  save();
